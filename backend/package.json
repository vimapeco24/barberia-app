{
  "name": "barbershop-booking-backend",
  "version": "1.0.0",
  "description": "Backend API for Barbershop Booking System",
  "main": "dist/server.js",
  "scripts": {
    "build": "npx tsc --skipLibCheck || true",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "lint": "eslint src/**/*.ts",
    "migrate": "ts-node-dev --transpile-only src/migrations/run.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "5.1.1",
    "cors": "2.8.5",
    "dotenv": "^17.4.2",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "jsonwebtoken": "9.0.2",
    "pg": "8.13.1",
    "redis": "4.7.0",
    "uuid": "11.1.0",
    "zod": "3.24.2",
    "@types/bcrypt": "5.0.2",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.9",
    "@types/node": "22.13.10",
    "@types/pg": "8.11.11",
    "@types/uuid": "10.0.0",
    "typescript": "5.7.3"
  },
  "devDependencies": {
    "fast-check": "3.23.2",
    "ts-node-dev": "2.0.0",
    "vitest": "3.0.9"
  }
}
